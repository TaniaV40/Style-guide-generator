    replacement_chunks {
      replacement_content: "<!DOCTYPE html>\n<html lang=\"en-GB\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>About | Tania Vorster</title>\n  <link rel=\"stylesheet\" href=\"/styles.css\">\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n</head>\n<body>\n  <nav class=\"navbar\">\n    <a href=\"/\" class=\"navbar-brand\">Tania Vorster</a>\n    <div class=\"navbar-nav desktop-nav\">\n      <a href=\"/\" class=\"nav-link\">Home</a>\n      <a href=\"/about.html\" class=\"nav-link\">About</a>\n      <a href=\"/work-history.html\" class=\"nav-link\">Work History</a>\n      <a href=\"/education.html\" class=\"nav-link\">Education</a>\n      <a href=\"/contact.html\" class=\"nav-link\">Contact</a>\n    </div>\n  </nav>\n\n  <header class=\"hero\">\n    <div class=\"hero-content\">\n      <h1>About Tania Vorster</h1>\n      <p>I restructure prose to achieve absolute clarity.</p>\n    </div>\n  </header>\n\n  <main class=\"section\">\n    <div class=\"card\">\n      <h2>My Approach</h2>\n      <p>I design comprehensive editing strategies for authors seeking rigorous stylistic improvement. My core philosophy is simple: <strong>I see the problem clearly. I fix it properly.</strong></p>\n      <br>\n      <p>Whether you need to map out your narrative rhythm, implement stricter point-of-view controls, or remove bloated syntax, I build a clear path forward for your manuscript.</p>\n    </div>\n  </main>\n\n  <footer class=\"footer\">\n    <p>&copy; 2026 Tania Vorster. All rights reserved.</p>\n  </footer>\n</body>\n</html>"
    }
