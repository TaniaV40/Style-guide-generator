    replacement_chunks {
      replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Outfit:wght@600;700&display=swap\');\n\n:root {\n  --purple-primary: #442B63;\n  --purple-secondary: #A27EAB;\n  --pink-accent: #E4BDDD;\n  --text-main: #333333;\n  --bg-white: #FFFFFF;\n  --bg-offwhite: #FAF8FB;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: \'DM Sans\', sans-serif;\n  color: var(--text-main);\n  background-color: var(--bg-white);\n  line-height: 1.6;\n}\n\nh1, h2, h3, h4, h5, h6 {\n  font-family: \'Outfit\', sans-serif;\n  color: var(--purple-primary);\n}\n\nh1 {\n  font-size: 40px;\n  font-weight: 700;\n  margin-bottom: 1rem;\n}\n\n@media (min-width: 1024px) {\n  h1 {\n    font-size: 64px;\n  }\n}\n\nh2 {\n  font-size: 32px;\n  font-weight: 600;\n  margin-bottom: 1rem;\n}\n\n@media (min-width: 1024px) {\n  h2 {\n    font-size: 44px;\n  }\n}\n\na {\n  color: var(--purple-primary);\n  text-decoration: none;\n  transition: color 0.2s ease;\n}\n\na:hover {\n  color: var(--pink-accent);\n}\n\n.navbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 1.5rem 2rem;\n  background-color: var(--bg-white);\n  border-bottom: 1px solid var(--purple-secondary);\n}\n\n.navbar-brand {\n  font-family: \'Outfit\', sans-serif;\n  font-size: 24px;\n  font-weight: 700;\n  color: var(--purple-primary);\n}\n\n.navbar-nav {\n  display: flex;\n  gap: 2rem;\n  flex-wrap: wrap;\n}\n\n@media (max-width: 768px) {\n  .navbar {\n    flex-direction: column;\n    gap: 1rem;\n  }\n  .navbar-nav {\n    justify-content: center;\n    gap: 1rem;\n  }\n}\n\n.nav-link {\n  font-weight: 500;\n}\n\n.hero {\n  background-color: var(--purple-primary);\n  color: var(--bg-white);\n  padding: 6rem 2rem;\n  text-align: center;\n}\n\n.hero-content {\n  max-width: 1000px;\n  margin: 0 auto;\n}\n\n.hero h1 {\n  color: var(--bg-white);\n}\n\n.hero p {\n  font-size: 1.25rem;\n  max-width: 800px;\n  margin: 0 auto;\n  opacity: 0.9;\n}\n\n.section {\n  padding: 4rem 2rem;\n}\n\n.bg-offwhite {\n  background-color: var(--bg-offwhite);\n}\n\n.card {\n  background-color: var(--bg-white);\n  border: 1px solid var(--purple-secondary);\n  border-radius: 8px;\n  padding: 2rem;\n  margin: 0 auto 2rem auto;\n  max-width: 900px;\n}\n\n.btn {\n  display: inline-block;\n  padding: 0.75rem 1.5rem;\n  font-family: \'Outfit\', sans-serif;\n  font-weight: 600;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: background-color 0.2s ease, color 0.2s ease;\n  font-size: 1rem;\n}\n\n.btn-primary {\n  background-color: var(--purple-primary);\n  color: var(--bg-white);\n}\n\n.btn-primary:hover {\n  background-color: var(--pink-accent);\n  color: var(--purple-primary);\n}\n\n.btn-primary:disabled {\n  background-color: var(--purple-secondary);\n  cursor: not-allowed;\n}\n\n.form-group {\n  margin-bottom: 1.5rem;\n}\n\n.form-control {\n  width: 100%;\n  padding: 1rem;\n  border: 1px solid var(--purple-secondary);\n  border-radius: 4px;\n  font-family: \'DM Sans\', sans-serif;\n  font-size: 1rem;\n  resize: vertical;\n}\n\n.form-control:focus {\n  outline: none;\n  border-color: var(--purple-primary);\n  box-shadow: 0 0 0 2px rgba(68, 43, 99, 0.2);\n}\n\n.footer {\n  background-color: var(--purple-primary);\n  color: var(--bg-white);\n  text-align: center;\n  padding: 2rem;\n  margin-top: 4rem;\n}\n\n/* Markdown Styles */\n.markdown-body {\n  font-family: \'DM Sans\', sans-serif;\n  color: var(--text-main);\n}\n.markdown-body h1, .markdown-body h2, .markdown-body h3 {\n  margin-top: 2.5rem;\n  margin-bottom: 1rem;\n  border-bottom: 1px solid var(--purple-secondary);\n  padding-bottom: 0.5rem;\n}\n.markdown-body h1 { font-size: 2rem; }\n.markdown-body h2 { font-size: 1.5rem; }\n.markdown-body ul, .markdown-body ol { padding-left: 2rem; margin-bottom: 1.5rem; }\n.markdown-body li { margin-bottom: 0.5rem; }\n.markdown-body p { margin-bottom: 1.5rem; }\n.markdown-body strong { color: var(--purple-primary); font-weight: 600; }\n.markdown-body code {\n  background-color: var(--bg-offwhite);\n  padding: 0.2rem 0.4rem;\n  border-radius: 4px;\n  font-family: monospace;\n}\n\n.loader {\n  display: none;\n  border: 4px solid var(--bg-offwhite);\n  border-top: 4px solid var(--purple-primary);\n  border-radius: 50%;\n  width: 48px;\n  height: 48px;\n  animation: spin 1s linear infinite;\n  margin: 3rem auto;\n}\n\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n.ghl-iframe-container {\n  width: 100%;\n  height: 600px;\n  border: 1px solid var(--purple-secondary);\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background-color: var(--bg-offwhite);\n  color: var(--purple-primary);\n  font-weight: 500;\n  text-align: center;\n  padding: 2rem;\n}"
