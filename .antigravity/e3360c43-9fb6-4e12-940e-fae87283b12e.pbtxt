      replacement_content: "import { marked } from \'https://cdn.jsdelivr.net/npm/marked/lib/marked.esm.js\';\n\ndocument.addEventListener(\'DOMContentLoaded\', () => {\n  // Initialize Lucide icons\n  if (typeof lucide !== \'undefined\') {\n    lucide.createIcons();\n  }\n\n  const analyzeBtn = document.getElementById(\'analyzeBtn\');\n  const writingSample = document.getElementById(\'writingSample\');\n  const loader = document.getElementById(\'loader\');\n  const resultCard = document.getElementById(\'resultCard\');\n  const resultContent = document.getElementById(\'resultContent\');\n\n  if (analyzeBtn && writingSample) {\n    analyzeBtn.addEventListener(\'click\', async () => {\n      const text = writingSample.value.trim();\n      if (!text) {\n        alert(\'Please paste a writing sample first.\');\n        return;\n      }\n\n      analyzeBtn.disabled = true;\n      loader.style.display = \'block\';\n      resultCard.style.display = \'none\';\n\n      try {\n        const response = await fetch(\'/api/analyze\', {\n          method: \'POST\',\n          headers: {\n            \'Content-Type\': \'application/json\'\n          },\n          body: JSON.stringify({ text })\n        });\n\n        const data = await response.json();\n\n        if (!response.ok) {\n          throw new Error(data.error || \'Failed to map style guide\');\n        }\n\n        // Render Markdown safely\n        resultContent.innerHTML = marked.parse(data.result);\n        resultCard.style.display = \'block\';\n      } catch (error) {\n        console.error(\'Error:\', error);\n        alert(\'An error occurred while building the style guide: \' + error.message);\n      } finally {\n        analyzeBtn.disabled = false;\n        loader.style.display = \'none\';\n      }\n    });\n  }\n});"
    }
