=\"loader\" class=\"loader\"></div>\n\n    <div id=\"resultCard\" class=\"card\" style=\"display: none;\">\n      <h2>Author Style Guide</h2>\n      <div id=\"resultContent\" class=\"markdown-body\"></div>\n    </div>\n  </main>\n\n  <footer class=\"footer\">\n    <p>&copy; 2026 Tania Vorster. All rights reserved.</p>\n  </footer>\n\n  <script type=\"module\" src=\"/client.js\"></script>\n</body>\n</html>"
